{#- Title, metadata, links, overview and highlight chips: the top of a project page. -#}
<h1>{{ title }}</h1>
<p class="meta">
  {% for item in [org, timeline, (tools | join(", ")) if tools] %}{% if item %}<span>{{ item }}</span>{% endif %}{% endfor %}
</p>
{% if links.length %}
<p class="bracket-links project-links">
  {% for link in links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}
</p>
{% endif %}
<div class="overview">{{ content | safe }}</div>
{% if highlights.length %}
<section class="highlights" aria-labelledby="highlights-title">
  <h2 id="highlights-title">Highlights</h2>
  <nav class="chips" aria-labelledby="highlights-title">
    {% for h in highlights %}<a class="chip" href="#{{ h.entry }}">{{ h.label }}</a>{% endfor %}
  </nav>
</section>
{% endif %}
