{#- A log entry's basic facts (`info:` in its front matter: language, tools, hardware, role, status),
    under its links. Set `e` to the entry before including this. -#}
{% set facts = e | entryInfo %}
{% if facts.length %}<dl class="entry-info">{% for fact in facts %}<div><dt>{{ fact.label }}</dt><dd>{{ fact.value }}</dd></div>{% endfor %}</dl>{% endif %}
