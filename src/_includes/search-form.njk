{#- The search box in the header of every page. A plain form: the results page (/search/, search.js) does the searching. -#}
<form class="search-form" action="/search/" method="get" role="search">
  <label class="visually-hidden" for="search-input">Search the site</label>
  <input class="search-input" id="search-input" name="q" type="search" autocomplete="off" spellcheck="false" required placeholder="Search">
  <button class="button" type="submit">Go</button>
</form>
