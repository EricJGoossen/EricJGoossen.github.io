From 80a859f7888b6adf729c113ce3e0d13e6c264a3a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 22 Oct 2026 15:09:11 +0000
Subject: [PATCH 3/3] Example arm: center each collision shape on its link, not
 on its joint

---
 examples/two_joint_arm.arow | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/examples/two_joint_arm.arow b/examples/two_joint_arm.arow
index 69cc39d..051cb46 100644
--- a/examples/two_joint_arm.arow
+++ b/examples/two_joint_arm.arow
@@ -65,7 +65,9 @@ joints:
       # sphere, one nonzero extent a capsule, zero radius a plain box. Here a
       # rounded box whose outer size matches the visual box.
       collision_pose:
-        translation: [0, 0, 0]
+        # Half the link length up local Y, so the shape covers the drawn box
+        # (the viewer draws each box from the joint outward, not centered on it).
+        translation: [0, 0.5, 0]
         rotation: [1, 0, 0, 0]
       collision_extents: [0.1, 0.45, 0.1]
       collision_radius: [0.05]
@@ -111,7 +113,7 @@ joints:
       joint_torque: [0, 0, 0, 0, 0, 0]
       visual_extents: [0.12, 0.4, 0.12]
       collision_pose:
-        translation: [0, 0, 0]
+        translation: [0, 0.4, 0]
         rotation: [1, 0, 0, 0]
       collision_extents: [0.08, 0.36, 0.08]
       collision_radius: [0.04]
-- 
2.43.0

