+// RECORDING HACK: rebuild the overlay from the broad phase's own world shape
+// poses, running the real narrow-phase contact Op on each body pair.
+void BuildCollisionOverlay(const achilles::interface::Simulation& sim) {
+  namespace alg = achilles::algorithms;
+  using alg::broad_phase::BroadPhaseField;
+  using F = alg::ScalarOperationT;
+  using STransform = achilles::domain::spatial::Transform<F>;
+  using SVec = achilles::domain::math::Vector3<F>;
+  using SQuat = achilles::domain::math::Quaternion<F>;
+  auto view = sim.ViewFor<alg::broad_phase::BroadPhaseAlgorithm>();
+  auto topo = sim.TopologyFor<achilles::engine::topology::TopologicalOrdering>();
+  auto& shapes = achilles::render::g_overlay_shapes;
+  auto& contacts = achilles::render::g_overlay_contacts;
+  shapes.clear();
+  contacts.clear();
+  auto world = [](const STransform& x, F a, F b, F c) {
+    return (x * STransform(SVec(a, b, c), SQuat::Identity())).Translation();
+  };
+  auto seg = [](std::vector<float>& v, const SVec& p, const SVec& q) {
+    v.insert(v.end(), {p.X(), p.Y(), p.Z(), q.X(), q.Y(), q.Z()});
+  };
+  struct Body { STransform x; SVec h; F r, m; std::size_t row; };
+  std::vector<Body> bodies;
+  for (std::size_t row = 0; row < topo.Size(); ++row) {
+    Body b{view.Load<BroadPhaseField::kWorldShapePose, F>(row),
+           view.Load<BroadPhaseField::kCollisionExtents, F>(row),
+           view.Load<BroadPhaseField::kCollisionRadius, F>(row).Value(),
+           view.Load<BroadPhaseField::kCollisionMargin, F>(row).Value(), row};
+    if (b.r <= 0 && b.h.X() == 0 && b.h.Y() == 0 && b.h.Z() == 0) continue;
+    bodies.push_back(b);
+    // Outline of the shape's outer box (inner half-extents + radius).
+    F e[3] = {b.h.X() + b.r, b.h.Y() + b.r, b.h.Z() + b.r};
+    for (int axis = 0; axis < 3; ++axis) {
+      for (int s1 = -1; s1 <= 1; s1 += 2) {
+        for (int s2 = -1; s2 <= 1; s2 += 2) {
+          F p[3], q[3];
+          int o1 = (axis + 1) % 3, o2 = (axis + 2) % 3;
+          p[axis] = -e[axis]; q[axis] = e[axis];
+          p[o1] = q[o1] = s1 * e[o1];
+          p[o2] = q[o2] = s2 * e[o2];
+          seg(shapes, world(b.x, p[0], p[1], p[2]), world(b.x, q[0], q[1], q[2]));
+        }
+      }
+    }
+  }
+  using B = alg::BatchOperationT;
+  auto batch = [](const Body& b) {
+    const auto& t = b.x.Translation();
+    const auto& q = b.x.Rotation();
+    return std::make_tuple(
+        alg::Transform(B(t.X()), B(t.Y()), B(t.Z()), B(q.W()), B(q.X()), B(q.Y()), B(q.Z())),
+        alg::Vector3(B(b.h.X()), B(b.h.Y()), B(b.h.Z())), alg::Scalar(B(b.r)), alg::Scalar(B(b.m)));
+  };
+  for (std::size_t i = 0; i < bodies.size(); ++i) {
+    for (std::size_t j = i + 1; j < bodies.size(); ++j) {
+      const Body& s = bodies[i];
+      const Body& t = bodies[j];
+      if (topo[s.row] == t.row || topo[t.row] == s.row) continue;  // parent/child
+      auto [xs, hs, rs, ms] = batch(s);
+      auto [xt, ht, rt, mt] = batch(t);
+      alg::Vector3 n;
+      alg::narrow_phase::ContactDistances d;
+      alg::narrow_phase::ContactPoints p;
+      alg::narrow_phase::ContactActiveMask active;
+      alg::narrow_phase::ComputeSweptBoxContactOp{}(
+          xt, ht, rt, mt, xs, hs, rs, ms, alg::LaneMask::Ones(), &n, &d, &p, &active);
+      for (std::size_t k = 0; k < alg::narrow_phase::kSweptBoxContactSlots; ++k) {
+        if (((active.AsStorage() >> (k * alg::kLanes)) & 1) == 0) continue;
+        SVec c(p(0, k).get(0), p(1, k).get(0), p(2, k).get(0));
+        SVec nn(n.X().get(0), n.Y().get(0), n.Z().get(0));
+        constexpr F kTick = 0.05F, kNormal = 0.3F;
+        seg(contacts, c - SVec(kTick, 0, 0), c + SVec(kTick, 0, 0));
+        seg(contacts, c - SVec(0, kTick, 0), c + SVec(0, kTick, 0));
+        seg(contacts, c - SVec(0, 0, kTick), c + SVec(0, 0, kTick));
+        seg(contacts, c, c + nn * kNormal);
+      }
+    }
+  }
+}
