index 0000000..50c17df
--- /dev/null
+++ b/tools/collision_probe.cpp
@@ -0,0 +1,73 @@
+// LOCAL TOOL (not for upstream): run narrow_phase::ComputeSweptBoxContactOp
+// on pairs read from stdin, one pair per SIMD lane.
+// stdin, one pair per line (source then target):
+//   hx hy hz r m tx ty tz qw qx qy qz   hx hy hz r m tx ty tz qw qx qy qz
+// stdout, one line per pair:
+//   nx ny nz  d0..d3  p0x p0y p0z .. p3x p3y p3z  a0..a3
+#include <array>
+#include <cstdio>
+#include <iostream>
+#include <vector>
+
+#include "algorithms/conventions.hpp"
+#include "algorithms/narrow_phase/narrow_phase_data.hpp"
+#include "algorithms/narrow_phase/narrow_phase_ops.hpp"
+
+using namespace achilles::algorithms;
+using narrow_phase::ComputeSweptBoxContactOp;
+using narrow_phase::ContactActiveMask;
+using narrow_phase::ContactDistances;
+using narrow_phase::ContactPoints;
+using narrow_phase::kSweptBoxContactSlots;
+
+struct Shape { float h[3], r, m, t[3], q[4]; };
+
+int main() {
+  std::vector<std::array<Shape, 2>> pairs;
+  std::array<Shape, 2> p{};
+  while (true) {
+    bool ok = true;
+    for (auto& s : p) {
+      ok = ok && (std::cin >> s.h[0] >> s.h[1] >> s.h[2] >> s.r >> s.m >> s.t[0] >> s.t[1] >> s.t[2] >> s.q[0] >> s.q[1] >> s.q[2] >> s.q[3]);
+    }
+    if (!ok) break;
+    pairs.push_back(p);
+  }
+  constexpr std::size_t L = kLanes;
+  for (std::size_t base = 0; base < pairs.size(); base += L) {
+    auto lanes = [&](int which, auto get) {
+      alignas(64) std::array<float, L> v{};
+      for (std::size_t l = 0; l < L; ++l) {
+        v[l] = get(pairs[std::min(base + l, pairs.size() - 1)][which]);
+      }
+      return BatchOperationT::load_aligned(v.data());
+    };
+    auto shape = [&](int w) {
+      Transform x(lanes(w, [](const Shape& s) { return s.t[0]; }), lanes(w, [](const Shape& s) { return s.t[1]; }),
+                  lanes(w, [](const Shape& s) { return s.t[2]; }), lanes(w, [](const Shape& s) { return s.q[0]; }),
+                  lanes(w, [](const Shape& s) { return s.q[1]; }), lanes(w, [](const Shape& s) { return s.q[2]; }),
+                  lanes(w, [](const Shape& s) { return s.q[3]; }));
+      Vector3 h(lanes(w, [](const Shape& s) { return s.h[0]; }), lanes(w, [](const Shape& s) { return s.h[1]; }),
+                lanes(w, [](const Shape& s) { return s.h[2]; }));
+      Scalar r(lanes(w, [](const Shape& s) { return s.r; }));
+      Scalar m(lanes(w, [](const Shape& s) { return s.m; }));
+      return std::make_tuple(x, h, r, m);
+    };
+    auto [xs, hs, rs, ms] = shape(0);
+    auto [xt, ht, rt, mt] = shape(1);
+    Vector3 normal;
+    ContactDistances dist;
+    ContactPoints point;
+    ContactActiveMask active;
+    ComputeSweptBoxContactOp{}(xt, ht, rt, mt, xs, hs, rs, ms, LaneMask::Ones(), &normal, &dist, &point, &active);
+    for (std::size_t l = 0; l < L && base + l < pairs.size(); ++l) {
+      std::printf("%.9g %.9g %.9g", normal.X().get(l), normal.Y().get(l), normal.Z().get(l));
+      for (std::size_t k = 0; k < kSweptBoxContactSlots; ++k) std::printf(" %.9g", dist(k, 0).get(l));
+      for (std::size_t k = 0; k < kSweptBoxContactSlots; ++k)
+        for (std::size_t i = 0; i < 3; ++i) std::printf(" %.9g", point(i, k).get(l));
+      for (std::size_t k = 0; k < kSweptBoxContactSlots; ++k)
+        std::printf(" %d", (active.AsStorage() >> (k * L + l)) & 1 ? 1 : 0);
+      std::printf("\n");
+    }
+  }
+}
