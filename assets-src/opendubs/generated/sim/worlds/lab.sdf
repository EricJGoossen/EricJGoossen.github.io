<?xml version="1.0"?>
<!-- A lab-sized room (10 m x 7 m) for the OpenDubs lidar/SLAM/Nav2 replay: outer
     walls, a partial divider, benches and cabinets along the walls, a pillar.
     The geometry is made up; it isn't any real room. -->
<sdf version="1.9">
  <world name="lab">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.55 0.55 0.53 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Each box: name, pose x y yaw, size x y z -->
    <model name="room">
      <static>true</static>
      <link name="walls">
        <!-- outer walls -->
        <collision name="n"><pose>0 3.55 0.6 0 0 0</pose><geometry><box><size>10.2 0.1 1.2</size></box></geometry></collision>
        <visual name="n"><pose>0 3.55 0.6 0 0 0</pose><geometry><box><size>10.2 0.1 1.2</size></box></geometry><material><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="s"><pose>0 -3.55 0.6 0 0 0</pose><geometry><box><size>10.2 0.1 1.2</size></box></geometry></collision>
        <visual name="s"><pose>0 -3.55 0.6 0 0 0</pose><geometry><box><size>10.2 0.1 1.2</size></box></geometry><material><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="e"><pose>5.05 0 0.6 0 0 0</pose><geometry><box><size>0.1 7.0 1.2</size></box></geometry></collision>
        <visual name="e"><pose>5.05 0 0.6 0 0 0</pose><geometry><box><size>0.1 7.0 1.2</size></box></geometry><material><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="w"><pose>-5.05 0 0.6 0 0 0</pose><geometry><box><size>0.1 7.0 1.2</size></box></geometry></collision>
        <visual name="w"><pose>-5.05 0 0.6 0 0 0</pose><geometry><box><size>0.1 7.0 1.2</size></box></geometry><material><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <!-- divider from the north wall, leaving a gap to the south -->
        <collision name="div"><pose>0.8 1.0 0.6 0 0 0</pose><geometry><box><size>0.12 5.0 1.2</size></box></geometry></collision>
        <visual name="div"><pose>0.8 1.0 0.6 0 0 0</pose><geometry><box><size>0.12 5.0 1.2</size></box></geometry><material><diffuse>0.75 0.78 0.82 1</diffuse></material></visual>
        <!-- benches and cabinets -->
        <collision name="b1"><pose>-3.2 3.05 0.45 0 0 0</pose><geometry><box><size>2.4 0.9 0.9</size></box></geometry></collision>
        <visual name="b1"><pose>-3.2 3.05 0.45 0 0 0</pose><geometry><box><size>2.4 0.9 0.9</size></box></geometry><material><diffuse>0.55 0.42 0.3 1</diffuse></material></visual>
        <collision name="b2"><pose>-4.55 -1.6 0.45 0 0 0</pose><geometry><box><size>0.9 1.8 0.9</size></box></geometry></collision>
        <visual name="b2"><pose>-4.55 -1.6 0.45 0 0 0</pose><geometry><box><size>0.9 1.8 0.9</size></box></geometry><material><diffuse>0.55 0.42 0.3 1</diffuse></material></visual>
        <collision name="b3"><pose>3.4 -3.05 0.45 0 0 0</pose><geometry><box><size>2.6 0.9 0.9</size></box></geometry></collision>
        <visual name="b3"><pose>3.4 -3.05 0.45 0 0 0</pose><geometry><box><size>2.6 0.9 0.9</size></box></geometry><material><diffuse>0.55 0.42 0.3 1</diffuse></material></visual>
        <collision name="c1"><pose>4.7 2.2 0.9 0 0 0</pose><geometry><box><size>0.6 1.6 1.8</size></box></geometry></collision>
        <visual name="c1"><pose>4.7 2.2 0.9 0 0 0</pose><geometry><box><size>0.6 1.6 1.8</size></box></geometry><material><diffuse>0.35 0.38 0.45 1</diffuse></material></visual>
        <collision name="c2"><pose>2.6 3.2 0.9 0 0 0</pose><geometry><box><size>1.2 0.6 1.8</size></box></geometry></collision>
        <visual name="c2"><pose>2.6 3.2 0.9 0 0 0</pose><geometry><box><size>1.2 0.6 1.8</size></box></geometry><material><diffuse>0.35 0.38 0.45 1</diffuse></material></visual>
        <!-- an island bench and a pillar in the open areas -->
        <collision name="isl"><pose>-2.4 -0.6 0.45 0 0 0.3</pose><geometry><box><size>1.6 0.8 0.9</size></box></geometry></collision>
        <visual name="isl"><pose>-2.4 -0.6 0.45 0 0 0.3</pose><geometry><box><size>1.6 0.8 0.9</size></box></geometry><material><diffuse>0.55 0.42 0.3 1</diffuse></material></visual>
        <collision name="p"><pose>3.0 0.2 0.6 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="p"><pose>3.0 0.2 0.6 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
