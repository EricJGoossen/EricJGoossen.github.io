<?xml version="1.0"?>
<!-- Eric's OpenDubs description (eric/open_dubs_description.urdf, unmodified) plus
     what Gazebo needs to simulate it: the two RPLIDAR A1s as lidar sensors on his
     front_lidar_link / back_lidar_link, and a holonomic drive standing in for the
     mecanum wheels (Gazebo can't do mecanum rollers without roller geometry). -->
<robot name="open_dubs" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="../eric/open_dubs_description.urdf"/>

  <!-- RPLIDAR A1: 360°, ~1° resolution, 0.15–12 m, ~7 Hz -->
  <xacro:macro name="rplidar" params="prefix">
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="gpu_lidar">
        <topic>scan_${prefix.replace('_lidar', '')}</topic>
        <gz_frame_id>${prefix}_link</gz_frame_id>
        <update_rate>7</update_rate>
        <always_on>true</always_on>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:rplidar prefix="front_lidar"/>
  <xacro:rplidar prefix="back_lidar"/>

  <!-- Frictionless wheels so the body-velocity drive below moves the base sideways
       as freely as mecanum rollers do. -->
  <xacro:macro name="slick" params="prefix">
    <gazebo reference="${prefix}_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  </xacro:macro>
  <xacro:slick prefix="drivewhl_FL"/>
  <xacro:slick prefix="drivewhl_FR"/>
  <xacro:slick prefix="drivewhl_BL"/>
  <xacro:slick prefix="drivewhl_BR"/>

  <gazebo>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/odom_tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
